# Copy this file to .env and fill in real values for your environment.
# Never commit a real .env file.

# --- Database ---------------------------------------------------------------
# Defaults to the bundled SQLite file if unset. SQLite is fine for a single
# instance / low-concurrency deployment. For multi-instance or heavier
# concurrent use, point this at PostgreSQL instead (driver: psycopg or
# psycopg2-binary must be added to requirements.txt first):
#   DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=

# --- Authentication -----------------------------------------------------
# Minutes of inactivity before a session is auto-logged-out.
SESSION_TIMEOUT_MINUTES=60

# --- Optional: AI Insights ------------------------------------------------
# If unset, AI Insights falls back to a rule-based summary generator --
# the app works with zero configuration either way.
OPENAI_API_KEY=
